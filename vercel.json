{
  "buildCommand": "vite build",
  "outputDirectory": ".vercel/output",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(manifest.json|manifest.webmanifest|sw.js|logo.png|icon-192.png|icon-512.png|icon-144.png|icon-96.png|apple-touch-icon.png|favicon.ico)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
